parameters:
    level: 6
    paths:
        - .
    excludePaths:
        - vendor/
        - node_modules/ (?)
        - build/
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - identifier: missingType.iterableValue
        # $attributes is set by the caller that includes block.json render templates.
        -
            identifier: variable.undefined
            message: '#^Variable \$attributes might not be defined\.$#'
            paths:
                - blocks/*/render.php
